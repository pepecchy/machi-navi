---
import "../style.css";
import { LANGS, LANG_NAMES, cities, dict, prefOf } from "../load.ts";
const prefs = [...new Set(cities.map((c) => c.pref))].sort((a, b) => a - b);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>machi-navi</title>
    <link rel="sitemap" href={`${base}/sitemap.xml`} />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@500;700&family=Noto+Sans+JP:wght@400;500;700&display=swap" />
  </head>
  <body>
    <div class="wrap">
      {LANGS.map((l) => (
        <section class="panel" lang={l}>
          <h2>{LANG_NAMES[l]}</h2>
          <p class="hint">{dict(l).home}</p>
          {prefs.map((p) => {
            const list = cities.filter((c) => c.pref === p);
            return (
              <>
                <h3 class="pref">{prefOf(list[0].name[l], l)}</h3>
                <ul class="home">
                  {list.map((c) => <li><a href={`${base}/${l}/${c.id}/`}>{c.name[l]}</a></li>)}
                </ul>
              </>
            );
          })}
        </section>
      ))}
    </div>
  </body>
</html>
