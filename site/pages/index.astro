---
import "../style.css";
import { LANGS, LANG_NAMES, cities, dict } from "../load.ts";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>machi-navi</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@500;700&family=Noto+Sans+JP:wght@400;500;700&display=swap" />
  </head>
  <body>
    <div class="wrap">
      {LANGS.map((l) => (
        <section class="panel" lang={l}>
          <h2>{LANG_NAMES[l]}</h2>
          <p class="hint">{dict(l).home}</p>
          <ul class="home">
            {cities.map((c) => <li><a href={`${base}/${l}/${c.id}/`}>{c.name[l]}</a></li>)}
          </ul>
        </section>
      ))}
    </div>
  </body>
</html>
